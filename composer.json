{
    "name": "iqwurks/iqwurkspunch",
    "description": "Open-source employee time clock and payroll system",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "dompdf/dompdf": "^3.1",
        "phpmailer/phpmailer": "^7.0",
        "symfony/http-client": "^8.1",
        "symfony/mailer": "^8.1",
        "twig/twig": "^3.28"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
