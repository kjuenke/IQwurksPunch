#!/usr/bin/env php
<?php
declare(strict_types=1);

use App\Console\CommandInterface;
use App\Console\ConsoleApplication;
use App\Console\LazyCommand;
use App\Console\Commands\BackupCreateCommand;
use App\Console\Commands\BackupListCommand;
use App\Console\Commands\BackupPruneCommand;
use App\Console\Commands\BackupRestoreCommand;
use App\Console\Commands\BackupRunCommand;
use App\Console\Commands\BackupVerifyCommand;
use App\Console\Commands\DatabaseCheckCommand;
use App\Console\Commands\DoctorCommand;
use App\Console\Commands\MailCheckCommand;
use App\Console\Commands\MailRetryCommand;
use App\Console\Commands\MaintenanceOffCommand;
use App\Console\Commands\MaintenanceOnCommand;
use App\Console\Commands\MaintenanceStatusCommand;
use App\Console\Commands\ScheduleRunCommand;
use App\Console\Commands\SchedulerCheckCommand;
use App\Console\Commands\VersionCommand;
use App\Core\AppInfo;
use App\Core\Config;
use App\Core\Container;
use App\Repositories\CompanySettingsRepository;

require __DIR__
    .
    '/vendor/autoload.php';


Config::load();


$requestedCommand =
    $argv[1]
    ??
    'help';


$databaseIndependentCommands = [
    'help',
    '--help',
    '-h',
    'version',
    'backup:list',
    'backup:prune',
    'backup:restore',
    'backup:verify',
    'database:check',
    'doctor',
    'mail:check',
    'maintenance:on',
    'maintenance:off',
    'maintenance:status',
    'scheduler:check'
];


if (
    in_array(
        $requestedCommand,
        $databaseIndependentCommands,
        true
    )
) {
    date_default_timezone_set(
        'America/Los_Angeles'
    );

} else {

    try {

        $repository =
            new CompanySettingsRepository(
                Container::db()
            );


        $company =
            $repository->get();


        $timezone =
            $company['timezone']
            ??
            'America/Los_Angeles';


        if (
            !in_array(
                $timezone,
                timezone_identifiers_list(),
                true
            )
        ) {
            $timezone =
                'America/Los_Angeles';
        }


        date_default_timezone_set(
            $timezone
        );

    } catch (\Throwable $exception) {

        date_default_timezone_set(
            'America/Los_Angeles'
        );
    }
}


/*
|--------------------------------------------------------------------------
| Internal scheduler execution lock
|--------------------------------------------------------------------------
|
| Cron has an external flock, but a manually started schedule:run command
| does not pass through that external lock. This second lock ensures that
| cron and manual scheduler executions cannot overlap.
|
*/

$schedulerLockHandle =
    null;


if ($requestedCommand === 'schedule:run') {

    $schedulerLockFile =
        '/tmp/iqwurks-schedule-run.internal.lock';


    $schedulerLockHandle =
        @fopen(
            $schedulerLockFile,
            'c+'
        );


    if ($schedulerLockHandle === false) {

        fwrite(
            STDERR,
            'Unable to open the internal scheduler lock file: '
            .
            $schedulerLockFile
            .
            PHP_EOL
        );


        exit(1);
    }


    if (
        !flock(
            $schedulerLockHandle,
            LOCK_EX
            |
            LOCK_NB
        )
    ) {
        fclose(
            $schedulerLockHandle
        );


        echo
            'Scheduler is already running. Skipping this execution.'
            .
            PHP_EOL;


        exit(0);
    }


    ftruncate(
        $schedulerLockHandle,
        0
    );


    rewind(
        $schedulerLockHandle
    );


    fwrite(
        $schedulerLockHandle,
        (string)getmypid()
        .
        PHP_EOL
    );


    fflush(
        $schedulerLockHandle
    );
}


$console =
    new ConsoleApplication(
        AppInfo::name(),
        AppInfo::version()
    );


$console->register(
    new VersionCommand()
);


$console->register(
    new MaintenanceOnCommand()
);


$console->register(
    new MaintenanceStatusCommand()
);


$console->register(
    new MaintenanceOffCommand()
);


$console->register(
    new LazyCommand(
        'backup:create',
        'Create and verify a timestamped SQLite database backup.',
        static fn (): CommandInterface =>
            new BackupCreateCommand()
    )
);


$console->register(
    new LazyCommand(
        'backup:list',
        'List available SQLite database backups.',
        static fn (): CommandInterface =>
            new BackupListCommand()
    )
);


$console->register(
    new LazyCommand(
        'backup:prune',
        'Preview or delete backups exceeding the retention limit.',
        static fn (): CommandInterface =>
            new BackupPruneCommand()
    )
);


$console->register(
    new LazyCommand(
        'backup:restore',
        'Preview or safely restore a verified SQLite backup.',
        static fn (): CommandInterface =>
            new BackupRestoreCommand()
    )
);


$console->register(
    new LazyCommand(
        'backup:run',
        'Create a verified backup and apply retention safely.',
        static fn (): CommandInterface =>
            new BackupRunCommand()
    )
);


$console->register(
    new LazyCommand(
        'backup:verify',
        'Verify the newest, a named, or all SQLite backups.',
        static fn (): CommandInterface =>
            new BackupVerifyCommand()
    )
);


$console->register(
    new LazyCommand(
        'database:check',
        'Check active SQLite database health and integrity.',
        static fn (): CommandInterface =>
            new DatabaseCheckCommand()
    )
);


$console->register(
    new LazyCommand(
        'doctor',
        'Run application, database, backup, mail, and scheduler diagnostics.',
        static fn (): CommandInterface =>
            new DoctorCommand()
    )
);


$console->register(
    new LazyCommand(
        'mail:check',
        'Check SMTP configuration, connectivity, TLS, and delivery status.',
        static fn (): CommandInterface =>
            new MailCheckCommand()
    )
);


$console->register(
    new LazyCommand(
        'mail:retry',
        'Preview or retry failed payroll-report email deliveries.',
        static fn (): CommandInterface =>
            new MailRetryCommand()
    )
);


$console->register(
    new LazyCommand(
        'scheduler:check',
        'Check scheduler cron, locks, activity, schedule, and recipients.',
        static fn (): CommandInterface =>
            new SchedulerCheckCommand()
    )
);


$console->register(
    new LazyCommand(
        'schedule:run',
        'Send each scheduled payroll report that is due.',
        static fn (): CommandInterface =>
            new ScheduleRunCommand()
    )
);


$exitCode =
    $console->run(
        $argv
    );


if (
    is_resource(
        $schedulerLockHandle
    )
) {
    flock(
        $schedulerLockHandle,
        LOCK_UN
    );


    fclose(
        $schedulerLockHandle
    );
}


exit(
    $exitCode
);
