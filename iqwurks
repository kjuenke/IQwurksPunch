require __DIR__
    .
    '/vendor/autoload.php';


Config::load();


$requestedCommand =
    $argv[1]
    ??
    'help';


$databaseIndependentCommands = [
    'help',
    '--help',
    '-h',
    'version',
    'backup:list',
    'backup:prune',
    'backup:restore',
    'backup:verify',
    'database:check',
    'doctor',
    'install:check',
    'mail:check',
    'maintenance:on',
    'maintenance:off',
    'maintenance:status',
    'package:build',
    'package:verify',
    'scheduler:check',
    'upgrade:check',
    'upgrade:plan',
    'upgrade:preview',
    'upgrade:apply',
    'upgrade:status',
    'upgrade:recovery-check'
];


if (
    in_array(
        $requestedCommand,
        $databaseIndependentCommands,
        true
    )
) {
    date_default_timezone_set(
        'America/Los_Angeles'
    );

} else {

    try {

        $repository =
            new CompanySettingsRepository(
                Container::db()
            );


        $company =
            $repository->get();


        $timezone =
            $company['timezone']
            ??
            'America/Los_Angeles';


        if (
            !in_array(
                $timezone,
                timezone_identifiers_list(),
                true
            )
        ) {
            $timezone =
                'America/Los_Angeles';
        }


        date_default_timezone_set(
            $timezone
        );

    } catch (\Throwable $exception) {

        date_default_timezone_set(
            'America/Los_Angeles'
        );
    }
}


/*
|--------------------------------------------------------------------------
| Internal scheduler execution lock
|--------------------------------------------------------------------------
|
| Cron has an external flock, but a manually started schedule:run command
| does not pass through that external lock. This second lock ensures that
| cron and manual scheduler executions cannot overlap.
|
*/

$schedulerLockHandle =
    null;


if ($requestedCommand === 'schedule:run') {

    $schedulerLockFile =
        '/tmp/iqwurks-schedule-run.internal.lock';


    $schedulerLockHandle =
        @fopen(
            $schedulerLockFile,
            'c+'
        );


    if ($schedulerLockHandle === false) {

        fwrite(
            STDERR,
            'Unable to open the internal scheduler lock file: '
            .
            $schedulerLockFile
            .
            PHP_EOL
        );


        exit(1);
    }


    if (
        !flock(
            $schedulerLockHandle,
            LOCK_EX
            |
            LOCK_NB
        )
    ) {
        fclose(
            $schedulerLockHandle
        );


        echo
            'Scheduler is already running. Skipping this execution.'
            .
            PHP_EOL;


        exit(0);
    }


    ftruncate(
        $schedulerLockHandle,
        0
    );


    rewind(
        $schedulerLockHandle
    );


    fwrite(
        $schedulerLockHandle,
        (string)getmypid()
        .
        PHP_EOL
    );


    fflush(
        $schedulerLockHandle
    );
}


/*
|--------------------------------------------------------------------------
| Internal email retry execution lock
|--------------------------------------------------------------------------
|
| Preview mode is read-only and does not require a lock. A mail:retry
| command using --send receives an exclusive non-blocking lock so that
| cron and manually started retry executions cannot process the same
| failed delivery simultaneously.
|
*/

$mailRetryLockHandle =
    null;


$mailRetrySendRequested =
    $requestedCommand === 'mail:retry'
    &&
    in_array(
        '--send',
        array_slice(
            $argv,
            2
        ),
        true
    );


if ($mailRetrySendRequested) {

    $mailRetryLockFile =
        '/tmp/iqwurks-mail-retry.internal.lock';


    $mailRetryLockHandle =
        @fopen(
            $mailRetryLockFile,
            'c+'
        );


    if ($mailRetryLockHandle === false) {

        fwrite(
            STDERR,
            'Unable to open the internal email retry lock file: '
            .
            $mailRetryLockFile
            .
            PHP_EOL
        );


        exit(1);
    }


    if (
        !flock(
            $mailRetryLockHandle,
            LOCK_EX
            |
            LOCK_NB
        )
    ) {
        fclose(
            $mailRetryLockHandle
        );


        echo
            'Email retry processing is already running. Skipping this execution.'
            .
            PHP_EOL;


        exit(0);
    }


    ftruncate(
        $mailRetryLockHandle,
        0
    );


    rewind(
        $mailRetryLockHandle
    );


    fwrite(
        $mailRetryLockHandle,
        (string)getmypid()
        .
        PHP_EOL
    );


    fflush(
        $mailRetryLockHandle
    );
}


