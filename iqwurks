$exitCode =
    $console->run(
        $argv
    );


if (
    is_resource(
        $mailRetryLockHandle
    )
) {
    flock(
        $mailRetryLockHandle,
        LOCK_UN
    );


    fclose(
        $mailRetryLockHandle
    );
}


if (
    is_resource(
        $schedulerLockHandle
    )
) {
    flock(
        $schedulerLockHandle,
        LOCK_UN
    );


    fclose(
        $schedulerLockHandle
    );
}


exit(
    $exitCode
);
