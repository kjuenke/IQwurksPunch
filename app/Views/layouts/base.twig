<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>
        {{ title|default(appName) }}
    </title>


    <link
        href="/assets/vendor/bootstrap/5.3.7/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <link
        href="/assets/vendor/bootstrap-icons/1.13.1/font/bootstrap-icons.min.css"
        rel="stylesheet"
    >

</head>


<body class="bg-light">


<nav class="navbar navbar-expand-lg navbar-dark bg-dark">

    <div class="container-fluid">


        <a
            class="navbar-brand"
            href="/dashboard"
        >

            <i class="bi bi-clock-history"></i>

            {{ appName }}

        </a>


        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNav"
            aria-controls="navbarNav"
            aria-expanded="false"
            aria-label="Toggle navigation"
        >

            <span class="navbar-toggler-icon"></span>

        </button>


        <div
            class="collapse navbar-collapse"
            id="navbarNav"
        >


            <ul class="navbar-nav me-auto">


                <li class="nav-item">

                    <a
                        class="nav-link
                            {% if activeMenu == 'dashboard' %}
                            active
                            {% endif %}
                        "
                        href="/dashboard"
                    >
                        Dashboard
                    </a>

                </li>


                <li class="nav-item">

                    <a
                        class="nav-link
                            {% if activeMenu == 'employees' %}
                            active
                            {% endif %}
                        "
                        href="/employees"
                    >
                        Employees
                    </a>

                </li>


                <li class="nav-item dropdown">

                    <a
                        class="nav-link dropdown-toggle
                            {% if activeMenu == 'reports' or activeMenu == 'payroll-periods' %}
                            active
                            {% endif %}
                        "
                        href="#"
                        id="reportsDropdown"
                        role="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >
                        Reports
                    </a>


                    <ul
                        class="dropdown-menu"
                        aria-labelledby="reportsDropdown"
                    >


                        <li>

                            <a
                                class="dropdown-item"
                                href="/reports/punches"
                            >

                                <i class="bi bi-clock me-2"></i>

                                Punch Report

                            </a>

                        </li>


                        <li>

                            <a
                                class="dropdown-item"
                                href="/reports/payroll"
                            >

                                <i class="bi bi-calendar-day me-2"></i>

                                Daily Payroll

                            </a>

                        </li>


                        <li>

                            <a
                                class="dropdown-item"
                                href="/reports/payroll/weekly"
                            >

                                <i class="bi bi-calendar-week me-2"></i>

                                Weekly Payroll

                            </a>

                        </li>


                        <li>

                            <a
                                class="dropdown-item"
                                href="/reports/payroll/workspace"
                            >

                                <i class="bi bi-funnel me-2"></i>

                                Payroll Workspace

                            </a>

                        </li>


                        <li>

                            <a
                                class="dropdown-item
                                    {% if activeMenu == 'payroll-periods' %}
                                    active
                                    {% endif %}
                                "
                                href="/payroll-periods"
                            >

                                <i class="bi bi-calendar2-check me-2"></i>

                                Payroll Periods

                            </a>

                        </li>


                        <li>

                            <hr class="dropdown-divider">

                        </li>


                        <li>

                            <a
                                class="dropdown-item"
                                href="/reports/email"
                            >

                                <i class="bi bi-envelope me-2"></i>

                                Email Reports

                            </a>

                        </li>


                        <li>

                            <a
                                class="dropdown-item"
                                href="/reports/email-history"
                            >

                                <i class="bi bi-clock-history me-2"></i>

                                Email History

                            </a>

                        </li>


                        <li>

                            <a
                                class="dropdown-item"
                                href="/admin/notifications"
                            >

                                <i class="bi bi-people me-2"></i>

                                Notification Center

                            </a>

                        </li>


                    </ul>

                </li>


                <li class="nav-item dropdown">

                    <a
                        class="nav-link dropdown-toggle
                            {% if activeMenu == 'settings' %}
                            active
                            {% endif %}
                        "
                        href="#"
                        id="settingsDropdown"
                        role="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >
                        Settings
                    </a>


                    <ul
                        class="dropdown-menu"
                        aria-labelledby="settingsDropdown"
                    >


                        <li>

                            <a
                                class="dropdown-item"
                                href="/admin/settings"
                            >

                                <i class="bi bi-building me-2"></i>

                                Company Settings

                            </a>

                        </li>


                        <li>

                            <a
                                class="dropdown-item"
                                href="/admin/labor-rules"
                            >

                                <i class="bi bi-clock-history me-2"></i>

                                Labor Rules

                            </a>

                        </li>


                        <li>

                            <a
                                class="dropdown-item"
                                href="/admin/users"
                            >

                                <i class="bi bi-person-gear me-2"></i>

                                Supervisor Users

                            </a>

                        </li>


                    </ul>

                </li>


            </ul>


            <ul class="navbar-nav">


                <li class="nav-item">

                    <a
                        class="nav-link"
                        href="/kiosk"
                    >

                        <i class="bi bi-display"></i>

                        Return to Kiosk

                    </a>

                </li>


                <li class="nav-item">

                    <form
                        method="post"
                        action="/logout"
                        class="d-inline"
                    >

                        <button
                            type="submit"
                            class="nav-link border-0 bg-transparent"
                        >

                            <i class="bi bi-box-arrow-right"></i>

                            Logout

                        </button>

                    </form>

                </li>


            </ul>


        </div>

    </div>

</nav>


<main class="container py-4">


    {% for message in flash %}

        <div
            class="alert alert-{{ message.type }} alert-dismissible fade show"
            role="alert"
        >

            {{ message.message }}

            <button
                type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"
            >
            </button>

        </div>

    {% endfor %}


    {% block content %}

    {% endblock %}


</main>


<footer class="text-center text-muted py-3">

    <small>

        Powered by {{ appName }}

        v{{ appVersion }}

        <br>

        {{ companyName }}

    </small>

</footer>


<script
    src="/assets/vendor/bootstrap/5.3.7/js/bootstrap.bundle.min.js"
>
</script>


</body>

</html>
