{% extends "layouts/base.twig" %}

{% block content %}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

    <div>

        <h1 class="mb-1">
            Employees
        </h1>

        <div class="text-muted">
            Manage active, inactive, and historical employee records.
        </div>

    </div>


    <a
        href="/employees/create"
        class="btn btn-primary"
    >

        <i class="bi bi-person-plus"></i>

        Add Employee

    </a>

</div>


<div class="card shadow-sm">

    <div class="card-body">


        <div class="table-responsive">

            <table class="table table-striped align-middle">

                <thead>

                    <tr>

                        <th>
                            Employee #
                        </th>

                        <th>
                            Name
                        </th>

                        <th>
                            Department
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Punch History
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>


                    {% for employee in employees %}

                        <tr>

                            <td>
                                {{ employee.employee_number }}
                            </td>


                            <td>

                                {{ employee.first_name }}
                                {{ employee.last_name }}

                            </td>


                            <td>
                                {{ employee.department|default('') ?: '—' }}
                            </td>


                            <td>

                                {% if employee.active %}

                                    <span class="badge text-bg-success">
                                        Active
                                    </span>

                                {% else %}

                                    <span class="badge text-bg-secondary">
                                        Inactive
                                    </span>

                                {% endif %}

                            </td>


                            <td>

                                {% if employee.punch_count > 0 %}

                                    <span class="badge text-bg-info">
                                        {{ employee.punch_count }}
                                        {% if employee.punch_count == 1 %}
                                            punch
                                        {% else %}
                                            punches
                                        {% endif %}
                                    </span>

                                {% else %}

                                    <span class="text-muted">
                                        No punches
                                    </span>

                                {% endif %}

                            </td>


                            <td>

                                <div class="d-flex flex-wrap gap-2">


                                    <a
                                        href="/employees/edit/{{ employee.id }}"
                                        class="btn btn-sm btn-outline-primary"
                                    >

                                        <i class="bi bi-pencil"></i>

                                        Edit

                                    </a>


                                    <a
                                        href="/employees/pin/{{ employee.id }}"
                                        class="btn btn-sm btn-outline-warning"
                                    >

                                        <i class="bi bi-key"></i>

                                        Change PIN

                                    </a>


                                    {% if employee.active %}

                                        <form
                                            method="post"
                                            action="/employees/deactivate"
                                            onsubmit="return confirm(
                                                'Deactivate this employee? The employee will no longer be able to use the kiosk, but payroll history will be preserved.'
                                            );"
                                        >

                                            <input
                                                type="hidden"
                                                name="id"
                                                value="{{ employee.id }}"
                                            >

                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-outline-secondary"
                                            >

                                                <i class="bi bi-person-dash"></i>

                                                Deactivate

                                            </button>

                                        </form>

                                    {% else %}

                                        <form
                                            method="post"
                                            action="/employees/activate"
                                        >

                                            <input
                                                type="hidden"
                                                name="id"
                                                value="{{ employee.id }}"
                                            >

                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-outline-success"
                                            >

                                                <i class="bi bi-person-check"></i>

                                                Activate

                                            </button>

                                        </form>

                                    {% endif %}


                                    {% if employee.can_delete %}

                                        <form
                                            method="post"
                                            action="/employees/delete"
                                            onsubmit="return confirm(
                                                'Permanently delete this employee? This action cannot be undone.'
                                            );"
                                        >

                                            <input
                                                type="hidden"
                                                name="id"
                                                value="{{ employee.id }}"
                                            >

                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                            >

                                                <i class="bi bi-trash"></i>

                                                Delete

                                            </button>

                                        </form>

                                    {% else %}

                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-danger"
                                            disabled
                                            title="Employees with punch history cannot be permanently deleted."
                                        >

                                            <i class="bi bi-lock"></i>

                                            Delete

                                        </button>

                                    {% endif %}


                                </div>


                                {% if not employee.can_delete %}

                                    <div class="small text-muted mt-2">

                                        Permanent deletion is disabled because
                                        payroll history exists. Deactivate this
                                        employee instead.

                                    </div>

                                {% endif %}

                            </td>

                        </tr>


                    {% else %}

                        <tr>

                            <td
                                colspan="6"
                                class="text-center text-muted"
                            >
                                No employees found.
                            </td>

                        </tr>

                    {% endfor %}


                </tbody>

            </table>

        </div>


    </div>

</div>


{% endblock %}
