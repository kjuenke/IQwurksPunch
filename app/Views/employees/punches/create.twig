{% extends "layouts/base.twig" %}

{% block content %}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

    <div>

        <h1 class="mb-1">
            Add Punch
        </h1>

        <div class="text-muted">

            {{ employee.employee_number }}
            —
            {{ employee.first_name }}
            {{ employee.last_name }}

        </div>

    </div>


    <a
        href="/employees/punches/{{ employee.id }}"
        class="btn btn-outline-secondary"
    >

        <i class="bi bi-arrow-left"></i>

        Back to Punches

    </a>

</div>


{% if errors is defined and errors %}

    <div class="alert alert-danger">

        <strong>
            The punch could not be added.
        </strong>

        <ul class="mb-0 mt-2">

            {% for error in errors %}

                <li>
                    {{ error }}
                </li>

            {% endfor %}

        </ul>

    </div>

{% endif %}


<div class="card shadow-sm">

    <div class="card-body">

        <div class="alert alert-info">

            This punch will be stored as a supervisor-created manual
            correction and included in payroll calculations.

        </div>


        <form
            method="post"
            action="/employees/punches/{{ employee.id }}/create"
        >

            <div class="row">

                <div class="col-md-6 mb-3">

                    <label
                        for="punchTime"
                        class="form-label"
                    >
                        Punch Date and Time
                    </label>

                    <input
                        id="punchTime"
                        type="datetime-local"
                        name="punch_time"
                        class="form-control"
                        value="{{ old.punch_time|default('') }}"
                        required
                    >

                    <div class="form-text">
                        Timezone: {{ companyTimezone }}
                    </div>

                </div>


                <div class="col-md-6 mb-3">

                    <label
                        for="punchType"
                        class="form-label"
                    >
                        Punch Type
                    </label>

                    <select
                        id="punchType"
                        name="punch_type"
                        class="form-select"
                        required
                    >

                        {% for value, label in punchTypes %}

                            <option
                                value="{{ value }}"
                                {% if old.punch_type|default('') == value %}
                                    selected
                                {% endif %}
                            >
                                {{ label }}
                            </option>

                        {% endfor %}

                    </select>

                </div>

            </div>


            <div class="mb-3">

                <label
                    for="notes"
                    class="form-label"
                >
                    Punch Notes
                </label>

                <textarea
                    id="notes"
                    name="notes"
                    rows="3"
                    class="form-control"
                    maxlength="500"
                >{{ old.notes|default('') }}</textarea>

                <div class="form-text">
                    Optional information associated with this punch.
                </div>

            </div>


            <div class="mb-4">

                <label
                    for="reason"
                    class="form-label"
                >
                    Correction Reason
                </label>

                <textarea
                    id="reason"
                    name="reason"
                    rows="4"
                    class="form-control"
                    minlength="5"
                    maxlength="500"
                    required
                >{{ old.reason|default('') }}</textarea>

                <div class="form-text">
                    Required. Explain why this manual punch is being added.
                </div>

            </div>


            <button
                type="submit"
                class="btn btn-primary"
            >

                <i class="bi bi-plus-circle"></i>

                Add Punch

            </button>


            <a
                href="/employees/punches/{{ employee.id }}"
                class="btn btn-secondary"
            >
                Cancel
            </a>

        </form>

    </div>

</div>

{% endblock %}
