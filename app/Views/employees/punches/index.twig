{% extends "layouts/base.twig" %}

{% block content %}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

    <div>

        <h1 class="mb-1">
            Manage Punches
        </h1>

        <div class="text-muted">

            {{ employee.employee_number }}
            —
            {{ employee.first_name }}
            {{ employee.last_name }}

        </div>

    </div>


    <div class="d-flex flex-wrap gap-2">

        <a
            href="/employees/punches/{{ employee.id }}/create"
            class="btn btn-primary"
        >

            <i class="bi bi-plus-circle"></i>

            Add Punch

        </a>


        <a
            href="/employees"
            class="btn btn-outline-secondary"
        >

            <i class="bi bi-arrow-left"></i>

            Back to Employees

        </a>

    </div>

</div>


<div class="alert alert-warning">

    <div class="d-flex gap-3">

        <i class="bi bi-shield-exclamation fs-4"></i>

        <div>

            <strong>
                Supervisor correction area
            </strong>

            <div>
                Every manually added, edited, or deleted punch requires a
                reason and is permanently recorded in correction history.
            </div>

            <div class="small mt-1">
                Display timezone: {{ companyTimezone }}
            </div>

        </div>

    </div>

</div>


<div class="card shadow-sm mb-4">

    <div class="card-header">

        <div class="d-flex justify-content-between align-items-center">

            <strong>
                Current Punch Records
            </strong>

            <span class="badge text-bg-secondary">
                {{ punches|length }}
            </span>

        </div>

    </div>


    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-striped align-middle">

                <thead>

                    <tr>

                        <th>
                            Date and Time
                        </th>

                        <th>
                            Type
                        </th>

                        <th>
                            Source
                        </th>

                        <th>
                            Notes
                        </th>

                        <th>
                            Correction
                        </th>

                        <th>
                            Actions
                        </th>

                    </tr>

                </thead>


                <tbody>

                    {% for punch in punches %}

                        <tr>

                            <td class="text-nowrap">

                                <strong>
                                    {{ punch.punch_time_local }}
                                </strong>

                                <div class="small text-muted">
                                    UTC: {{ punch.punch_time }}
                                </div>

                            </td>


                            <td>

                                {% if punch.punch_type == 'clock_in' %}

                                    <span class="badge text-bg-success">
                                        {{ punch.punch_type_label }}
                                    </span>

                                {% elseif punch.punch_type == 'clock_out' %}

                                    <span class="badge text-bg-danger">
                                        {{ punch.punch_type_label }}
                                    </span>

                                {% elseif punch.punch_type in ['meal_out', 'meal_in'] %}

                                    <span class="badge text-bg-warning">
                                        {{ punch.punch_type_label }}
                                    </span>

                                {% else %}

                                    <span class="badge text-bg-info">
                                        {{ punch.punch_type_label }}
                                    </span>

                                {% endif %}

                            </td>


                            <td>

                                {% if punch.source == 'manual' %}

                                    <span class="badge text-bg-primary">
                                        Manual
                                    </span>

                                {% else %}

                                    <span class="badge text-bg-secondary">
                                        Kiosk
                                    </span>

                                {% endif %}

                            </td>


                            <td>

                                {% if punch.notes|default('') %}

                                    {{ punch.notes }}

                                {% else %}

                                    <span class="text-muted">
                                        —
                                    </span>

                                {% endif %}

                            </td>


                            <td>

                                {% if punch.corrected_at_local %}

                                    <div>
                                        {{ punch.corrected_at_local }}
                                    </div>

                                    {% if punch.correction_reason|default('') %}

                                        <div class="small text-muted">
                                            {{ punch.correction_reason }}
                                        </div>

                                    {% endif %}

                                {% else %}

                                    <span class="text-muted">
                                        Not corrected
                                    </span>

                                {% endif %}

                            </td>


                            <td>

                                <div class="d-flex flex-wrap gap-2">

                                    <a
                                        href="/employees/punches/edit/{{ punch.id }}"
                                        class="btn btn-sm btn-outline-primary"
                                    >

                                        <i class="bi bi-pencil"></i>

                                        Edit

                                    </a>


                                    <button
                                        type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deletePunchModal{{ punch.id }}"
                                    >

                                        <i class="bi bi-trash"></i>

                                        Delete

                                    </button>

                                </div>

                            </td>

                        </tr>


                        <div
                            class="modal fade"
                            id="deletePunchModal{{ punch.id }}"
                            tabindex="-1"
                            aria-labelledby="deletePunchModalLabel{{ punch.id }}"
                            aria-hidden="true"
                        >

                            <div class="modal-dialog">

                                <div class="modal-content">

                                    <form
                                        method="post"
                                        action="/employees/punches/delete/{{ punch.id }}"
                                    >

                                        <div class="modal-header">

                                            <h5
                                                class="modal-title"
                                                id="deletePunchModalLabel{{ punch.id }}"
                                            >
                                                Delete Punch
                                            </h5>

                                            <button
                                                type="button"
                                                class="btn-close"
                                                data-bs-dismiss="modal"
                                                aria-label="Close"
                                            ></button>

                                        </div>


                                        <div class="modal-body">

                                            <div class="alert alert-danger">

                                                This will remove the punch from
                                                payroll calculations. The
                                                deletion itself will remain in
                                                correction history.

                                            </div>


                                            <dl class="row">

                                                <dt class="col-sm-4">
                                                    Employee
                                                </dt>

                                                <dd class="col-sm-8">

                                                    {{ employee.first_name }}
                                                    {{ employee.last_name }}

                                                </dd>


                                                <dt class="col-sm-4">
                                                    Punch
                                                </dt>

                                                <dd class="col-sm-8">

                                                    {{ punch.punch_type_label }}
                                                    <br>

                                                    {{ punch.punch_time_local }}

                                                </dd>

                                            </dl>


                                            <div class="mb-3">

                                                <label
                                                    for="deleteReason{{ punch.id }}"
                                                    class="form-label"
                                                >
                                                    Deletion Reason
                                                </label>

                                                <textarea
                                                    id="deleteReason{{ punch.id }}"
                                                    name="reason"
                                                    rows="3"
                                                    class="form-control"
                                                    minlength="5"
                                                    maxlength="500"
                                                    required
                                                ></textarea>

                                                <div class="form-text">
                                                    Explain why this punch must
                                                    be removed.
                                                </div>

                                            </div>


                                            <div class="mb-3">

                                                <label
                                                    for="deleteConfirmation{{ punch.id }}"
                                                    class="form-label"
                                                >
                                                    Type DELETE to confirm
                                                </label>

                                                <input
                                                    id="deleteConfirmation{{ punch.id }}"
                                                    type="text"
                                                    name="confirmation"
                                                    class="form-control"
                                                    autocomplete="off"
                                                    required
                                                >

                                            </div>

                                        </div>


                                        <div class="modal-footer">

                                            <button
                                                type="button"
                                                class="btn btn-secondary"
                                                data-bs-dismiss="modal"
                                            >
                                                Cancel
                                            </button>

                                            <button
                                                type="submit"
                                                class="btn btn-danger"
                                            >

                                                <i class="bi bi-trash"></i>

                                                Delete Punch

                                            </button>

                                        </div>

                                    </form>

                                </div>

                            </div>

                        </div>

                    {% else %}

                        <tr>

                            <td
                                colspan="6"
                                class="text-center text-muted py-4"
                            >

                                No punch records exist for this employee.

                                <div class="mt-3">

                                    <a
                                        href="/employees/punches/{{ employee.id }}/create"
                                        class="btn btn-sm btn-primary"
                                    >
                                        Add the First Punch
                                    </a>

                                </div>

                            </td>

                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

</div>


<div class="card shadow-sm">

    <div class="card-header">

        <div class="d-flex justify-content-between align-items-center">

            <strong>
                Punch Correction History
            </strong>

            <span class="badge text-bg-secondary">
                {{ history|length }}
            </span>

        </div>

    </div>


    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-sm table-striped align-middle">

                <thead>

                    <tr>

                        <th>
                            Corrected
                        </th>

                        <th>
                            Action
                        </th>

                        <th>
                            Previous Value
                        </th>

                        <th>
                            New Value
                        </th>

                        <th>
                            Reason
                        </th>

                        <th>
                            Supervisor
                        </th>

                    </tr>

                </thead>


                <tbody>

                    {% for entry in history %}

                        <tr>

                            <td class="text-nowrap">
                                {{ entry.created_at_local|default('Unknown') }}
                            </td>


                            <td>

                                {% if entry.action == 'created' %}

                                    <span class="badge text-bg-success">
                                        Added
                                    </span>

                                {% elseif entry.action == 'updated' %}

                                    <span class="badge text-bg-warning">
                                        Edited
                                    </span>

                                {% else %}

                                    <span class="badge text-bg-danger">
                                        Deleted
                                    </span>

                                {% endif %}

                            </td>


                            <td>

                                {% if entry.old_punch_time_local %}

                                    {{ entry.old_punch_type_label }}
                                    <br>

                                    <span class="small text-muted">
                                        {{ entry.old_punch_time_local }}
                                    </span>

                                {% else %}

                                    <span class="text-muted">
                                        —
                                    </span>

                                {% endif %}

                            </td>


                            <td>

                                {% if entry.new_punch_time_local %}

                                    {{ entry.new_punch_type_label }}
                                    <br>

                                    <span class="small text-muted">
                                        {{ entry.new_punch_time_local }}
                                    </span>

                                {% else %}

                                    <span class="text-muted">
                                        —
                                    </span>

                                {% endif %}

                            </td>


                            <td>
                                {{ entry.reason }}
                            </td>


                            <td>
                                {{ entry.username|default('Unknown supervisor') }}
                            </td>

                        </tr>

                    {% else %}

                        <tr>

                            <td
                                colspan="6"
                                class="text-center text-muted py-4"
                            >
                                No supervisor corrections have been recorded.
                            </td>

                        </tr>

                    {% endfor %}

                </tbody>

            </table>

        </div>

    </div>

</div>

{% endblock %}
