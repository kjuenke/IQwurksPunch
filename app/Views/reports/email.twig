{% extends "layouts/base.twig" %}

{% block content %}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

    <div>

        <h1 class="mb-1">
            Email Reports
        </h1>

        <div class="text-muted">
            Send payroll reports and configure automatic delivery.
        </div>

    </div>


    <a
        href="/admin/notifications"
        class="btn btn-outline-primary"
    >

        <i class="bi bi-people"></i>

        Manage Recipients

    </a>

</div>


<div class="row g-4">


    <div class="col-lg-6">

        <div class="card shadow-sm h-100">

            <div class="card-body">


                <h5 class="card-title">
                    Daily Payroll Report
                </h5>


                <p class="text-muted">

                    Generate the current daily payroll summary and send it
                    to every active recipient subscribed to daily payroll.

                </p>


                {% if dailyRecipientCount > 0 %}

                    <div class="alert alert-info">

                        <i class="bi bi-people"></i>

                        {{ dailyRecipientCount }}
                        active daily-payroll
                        {% if dailyRecipientCount == 1 %}
                            recipient
                        {% else %}
                            recipients
                        {% endif %}

                    </div>

                {% else %}

                    <div class="alert alert-warning">

                        <i class="bi bi-exclamation-triangle"></i>

                        No active daily-payroll recipients are configured.

                        <a
                            href="/admin/notifications"
                            class="alert-link"
                        >
                            Configure recipients
                        </a>

                    </div>

                {% endif %}


                <form
                    method="post"
                    action="/reports/email/send-daily"
                    onsubmit="sendDailyReport();"
                >

                    <input
                        type="hidden"
                        name="report_type"
                        value="daily"
                    >


                    <button
                        id="sendDailyReportButton"
                        class="btn btn-primary"
                        type="submit"
                        {% if dailyRecipientCount == 0 %}
                        disabled
                        {% endif %}
                    >

                        <i class="bi bi-envelope"></i>

                        <span id="sendDailyReportText">
                            Send Daily Payroll Report
                        </span>

                    </button>


                </form>


            </div>

        </div>

    </div>


    <div class="col-lg-6">

        <div class="card shadow-sm h-100">

            <div class="card-body">


                <h5 class="card-title">
                    Weekly Payroll Report
                </h5>


                <p class="text-muted">

                    Generate a weekly payroll summary and send it to every
                    active recipient subscribed to weekly payroll.

                </p>


                {% if weeklyRecipientCount > 0 %}

                    <div class="alert alert-info">

                        <i class="bi bi-people"></i>

                        {{ weeklyRecipientCount }}
                        active weekly-payroll
                        {% if weeklyRecipientCount == 1 %}
                            recipient
                        {% else %}
                            recipients
                        {% endif %}

                    </div>

                {% else %}

                    <div class="alert alert-warning">

                        <i class="bi bi-exclamation-triangle"></i>

                        No active weekly-payroll recipients are configured.

                        <a
                            href="/admin/notifications"
                            class="alert-link"
                        >
                            Configure recipients
                        </a>

                    </div>

                {% endif %}


                <form
                    method="post"
                    action="/reports/email/send-daily"
                    onsubmit="sendWeeklyReport();"
                >

                    <input
                        type="hidden"
                        name="report_type"
                        value="weekly"
                    >


                    <div class="mb-3">

                        <label
                            class="form-label"
                            for="weekly_reference_date"
                        >
                            Week Reference Date
                        </label>

                        <input
                            type="date"
                            class="form-control"
                            id="weekly_reference_date"
                            name="reference_date"
                        >

                        <div class="form-text">

                            Select any date within the desired payroll week.
                            Leave blank to use the current company-local date.

                        </div>

                    </div>


                    <button
                        id="sendWeeklyReportButton"
                        class="btn btn-primary"
                        type="submit"
                        {% if weeklyRecipientCount == 0 %}
                        disabled
                        {% endif %}
                    >

                        <i class="bi bi-envelope"></i>

                        <span id="sendWeeklyReportText">
                            Send Weekly Payroll Report
                        </span>

                    </button>


                </form>


            </div>

        </div>

    </div>


    <div class="col-12">

        <div class="card shadow-sm">

            <div class="card-body">


                <div class="d-flex flex-wrap justify-content-between align-items-start">

                    <div>

                        <h5 class="card-title">
                            Automatic Daily Delivery
                        </h5>


                        <p class="text-muted">

                            Automatically send the daily payroll report at the
                            configured company-local time.

                        </p>

                    </div>


                    <a
                        href="/reports/email-history"
                        class="btn btn-outline-secondary"
                    >

                        <i class="bi bi-clock-history"></i>

                        View Email History

                    </a>

                </div>


                <form
                    method="post"
                    action="/reports/email/schedule"
                    onsubmit="saveSchedule();"
                >


                    <div class="form-check form-switch mb-3">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            role="switch"
                            id="enabled"
                            name="enabled"
                            {% if schedule.enabled %}
                            checked
                            {% endif %}
                        >

                        <label
                            class="form-check-label"
                            for="enabled"
                        >
                            Enable automatic daily report delivery
                        </label>

                    </div>


                    <div class="mb-3">

                        <label
                            class="form-label"
                            for="send_time"
                        >
                            Send Time
                        </label>

                        <input
                            type="time"
                            class="form-control"
                            id="send_time"
                            name="send_time"
                            value="{{ schedule.send_time|default('18:00') }}"
                            required
                        >

                        <div class="form-text">
                            Uses the timezone configured in Company Settings.
                        </div>

                    </div>


                    <div class="form-check mb-3">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="weekdays_only"
                            name="weekdays_only"
                            {% if schedule.weekdays_only %}
                            checked
                            {% endif %}
                        >

                        <label
                            class="form-check-label"
                            for="weekdays_only"
                        >
                            Send Monday through Friday only
                        </label>

                    </div>


                    {% if schedule.last_sent_at %}

                        <div class="alert alert-secondary">

                            <strong>
                                Last automatic send:
                            </strong>

                            {{ schedule.last_sent_at|company_date }}

                        </div>

                    {% else %}

                        <div class="alert alert-secondary">
                            No automatic daily report has been sent yet.
                        </div>

                    {% endif %}


                    <button
                        id="saveScheduleButton"
                        class="btn btn-success"
                        type="submit"
                    >

                        <i class="bi bi-save"></i>

                        <span id="saveScheduleText">
                            Save Schedule
                        </span>

                    </button>


                </form>


            </div>

        </div>

    </div>


</div>


<script>

function beginButtonAction(
    buttonId,
    textId,
    progressText
)
{
    const button =
        document.getElementById(
            buttonId
        );


    const text =
        document.getElementById(
            textId
        );


    if (!button || !text) {
        return;
    }


    button.disabled = true;


    text.textContent =
        progressText;


    button.insertAdjacentHTML(
        'afterbegin',
        '<span class="spinner-border spinner-border-sm me-2"></span>'
    );
}


function sendDailyReport()
{
    beginButtonAction(
        'sendDailyReportButton',
        'sendDailyReportText',
        'Sending Daily Report...'
    );
}


function sendWeeklyReport()
{
    beginButtonAction(
        'sendWeeklyReportButton',
        'sendWeeklyReportText',
        'Sending Weekly Report...'
    );
}


function saveSchedule()
{
    beginButtonAction(
        'saveScheduleButton',
        'saveScheduleText',
        'Saving Schedule...'
    );
}

</script>


{% endblock %}
