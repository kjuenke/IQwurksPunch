{% extends "layouts/base.twig" %}

{% block content %}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

    <div>

        <h1 class="mb-1">
            Email Reports
        </h1>

        <div class="text-muted">
            Send payroll reports and configure automatic delivery.
        </div>

    </div>


    <div class="d-flex gap-2">

        <a
            href="/reports/email-history"
            class="btn btn-outline-secondary"
        >

            <i class="bi bi-clock-history"></i>

            Email History

        </a>


        <a
            href="/admin/notifications"
            class="btn btn-outline-primary"
        >

            <i class="bi bi-people"></i>

            Manage Recipients

        </a>

    </div>

</div>


<div class="row g-4">


    <div class="col-lg-6">

        <div class="card shadow-sm h-100">

            <div class="card-body">


                <h5 class="card-title">
                    Daily Payroll Report
                </h5>


                <p class="text-muted">

                    Generate the current daily payroll summary and send it
                    to every active recipient subscribed to daily payroll.

                </p>


                {% if dailyRecipientCount > 0 %}

                    <div class="alert alert-info">

                        <i class="bi bi-people"></i>

                        {{ dailyRecipientCount }}
                        active daily-payroll
                        {% if dailyRecipientCount == 1 %}
                            recipient
                        {% else %}
                            recipients
                        {% endif %}

                    </div>

                {% else %}

                    <div class="alert alert-warning">

                        <i class="bi bi-exclamation-triangle"></i>

                        No active daily-payroll recipients are configured.

                        <a
                            href="/admin/notifications"
                            class="alert-link"
                        >
                            Configure recipients
                        </a>

                    </div>

                {% endif %}


                <form
                    method="post"
                    action="/reports/email/send-daily"
                    onsubmit="sendDailyReport();"
                >

                    <input
                        type="hidden"
                        name="report_type"
                        value="daily"
                    >


                    <button
                        id="sendDailyReportButton"
                        class="btn btn-primary"
                        type="submit"
                        {% if dailyRecipientCount == 0 %}
                        disabled
                        {% endif %}
                    >

                        <i class="bi bi-envelope"></i>

                        <span id="sendDailyReportText">
                            Send Daily Payroll Report
                        </span>

                    </button>

                </form>


            </div>

        </div>

    </div>


    <div class="col-lg-6">

        <div class="card shadow-sm h-100">

            <div class="card-body">


                <h5 class="card-title">
                    Weekly Payroll Report
                </h5>


                <p class="text-muted">

                    Generate a weekly payroll summary and send it to every
                    active recipient subscribed to weekly payroll.

                </p>


                {% if weeklyRecipientCount > 0 %}

                    <div class="alert alert-info">

                        <i class="bi bi-people"></i>

                        {{ weeklyRecipientCount }}
                        active weekly-payroll
                        {% if weeklyRecipientCount == 1 %}
                            recipient
                        {% else %}
                            recipients
                        {% endif %}

                    </div>

                {% else %}

                    <div class="alert alert-warning">

                        <i class="bi bi-exclamation-triangle"></i>

                        No active weekly-payroll recipients are configured.

                        <a
                            href="/admin/notifications"
                            class="alert-link"
                        >
                            Configure recipients
                        </a>

                    </div>

                {% endif %}


                <form
                    method="post"
                    action="/reports/email/send-daily"
                    onsubmit="sendWeeklyReport();"
                >

                    <input
                        type="hidden"
                        name="report_type"
                        value="weekly"
                    >


                    <div class="mb-3">

                        <label
                            class="form-label"
                            for="weekly_reference_date"
                        >
                            Week Reference Date
                        </label>

                        <input
                            type="date"
                            class="form-control"
                            id="weekly_reference_date"
                            name="reference_date"
                        >

                        <div class="form-text">

                            Select any date within the desired payroll week.
                            Leave blank to use the current company-local date.

                        </div>

                    </div>


                    <button
                        id="sendWeeklyReportButton"
                        class="btn btn-primary"
                        type="submit"
                        {% if weeklyRecipientCount == 0 %}
                        disabled
                        {% endif %}
                    >

                        <i class="bi bi-envelope"></i>

                        <span id="sendWeeklyReportText">
                            Send Weekly Payroll Report
                        </span>

                    </button>

                </form>


            </div>

        </div>

    </div>


    <div class="col-lg-6">

        <div class="card shadow-sm h-100">

            <div class="card-body">


                <h5 class="card-title">
                    Automatic Daily Delivery
                </h5>


                <p class="text-muted">

                    Automatically send the daily payroll report at the
                    configured company-local time.

                </p>


                <form
                    method="post"
                    action="/reports/email/schedule"
                    onsubmit="saveDailySchedule();"
                >

                    <input
                        type="hidden"
                        name="report_type"
                        value="daily_payroll"
                    >


                    <div class="form-check form-switch mb-3">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            role="switch"
                            id="daily_enabled"
                            name="enabled"
                            {% if dailySchedule.enabled %}
                            checked
                            {% endif %}
                        >

                        <label
                            class="form-check-label"
                            for="daily_enabled"
                        >
                            Enable automatic daily delivery
                        </label>

                    </div>


                    <div class="mb-3">

                        <label
                            class="form-label"
                            for="daily_send_time"
                        >
                            Send Time
                        </label>

                        <input
                            type="time"
                            class="form-control"
                            id="daily_send_time"
                            name="send_time"
                            value="{{ dailySchedule.send_time|default('18:00') }}"
                            required
                        >

                        <div class="form-text">
                            Uses the timezone configured in Company Settings.
                        </div>

                    </div>


                    <div class="form-check mb-3">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="daily_weekdays_only"
                            name="weekdays_only"
                            {% if dailySchedule.weekdays_only %}
                            checked
                            {% endif %}
                        >

                        <label
                            class="form-check-label"
                            for="daily_weekdays_only"
                        >
                            Send Monday through Friday only
                        </label>

                    </div>


                    {% if dailySchedule.last_sent_at %}

                        <div class="alert alert-secondary">

                            <strong>
                                Last successful daily send:
                            </strong>

                            {{ dailySchedule.last_sent_at|company_date }}

                        </div>

                    {% else %}

                        <div class="alert alert-secondary">
                            No automatic daily report has been sent yet.
                        </div>

                    {% endif %}


                    {% if dailySchedule.last_result == 'failed' %}

                        <div class="alert alert-danger">

                            <strong>
                                Last result:
                            </strong>

                            Failed

                            {% if dailySchedule.last_error %}

                                <div class="mt-2">
                                    {{ dailySchedule.last_error }}
                                </div>

                            {% endif %}

                        </div>

                    {% endif %}


                    <button
                        id="saveDailyScheduleButton"
                        class="btn btn-success"
                        type="submit"
                    >

                        <i class="bi bi-save"></i>

                        <span id="saveDailyScheduleText">
                            Save Daily Schedule
                        </span>

                    </button>

                </form>


            </div>

        </div>

    </div>


    <div class="col-lg-6">

        <div class="card shadow-sm h-100">

            <div class="card-body">


                <h5 class="card-title">
                    Automatic Weekly Delivery
                </h5>


                <p class="text-muted">

                    Automatically send the previous completed payroll week
                    on the selected company-local day and time.

                </p>


                <form
                    method="post"
                    action="/reports/email/schedule"
                    onsubmit="saveWeeklySchedule();"
                >

                    <input
                        type="hidden"
                        name="report_type"
                        value="weekly_payroll"
                    >


                    <div class="form-check form-switch mb-3">

                        <input
                            class="form-check-input"
                            type="checkbox"
                            role="switch"
                            id="weekly_enabled"
                            name="enabled"
                            {% if weeklySchedule.enabled %}
                            checked
                            {% endif %}
                        >

                        <label
                            class="form-check-label"
                            for="weekly_enabled"
                        >
                            Enable automatic weekly delivery
                        </label>

                    </div>


                    <div class="mb-3">

                        <label
                            class="form-label"
                            for="weekly_send_day_of_week"
                        >
                            Delivery Day
                        </label>

                        <select
                            class="form-select"
                            id="weekly_send_day_of_week"
                            name="send_day_of_week"
                            required
                        >

                            {% set selectedWeeklyDay =
                                weeklySchedule.send_day_of_week|default(1)
                            %}

                            {% for dayNumber, dayName in weeklyDayOptions %}

                                <option
                                    value="{{ dayNumber }}"
                                    {% if selectedWeeklyDay == dayNumber %}
                                    selected
                                    {% endif %}
                                >
                                    {{ dayName }}
                                </option>

                            {% endfor %}

                        </select>

                    </div>


                    <div class="mb-3">

                        <label
                            class="form-label"
                            for="weekly_send_time"
                        >
                            Send Time
                        </label>

                        <input
                            type="time"
                            class="form-control"
                            id="weekly_send_time"
                            name="send_time"
                            value="{{ weeklySchedule.send_time|default('08:00') }}"
                            required
                        >

                        <div class="form-text">

                            Uses the timezone configured in Company Settings.
                            The previous completed company workweek will be
                            included.

                        </div>

                    </div>


                    {% if weeklySchedule.last_sent_at %}

                        <div class="alert alert-secondary">

                            <strong>
                                Last successful weekly send:
                            </strong>

                            {{ weeklySchedule.last_sent_at|company_date }}

                        </div>

                    {% else %}

                        <div class="alert alert-secondary">
                            No automatic weekly report has been sent yet.
                        </div>

                    {% endif %}


                    {% if weeklySchedule.last_result == 'failed' %}

                        <div class="alert alert-danger">

                            <strong>
                                Last result:
                            </strong>

                            Failed

                            {% if weeklySchedule.last_error %}

                                <div class="mt-2">
                                    {{ weeklySchedule.last_error }}
                                </div>

                            {% endif %}

                        </div>

                    {% endif %}


                    <button
                        id="saveWeeklyScheduleButton"
                        class="btn btn-success"
                        type="submit"
                    >

                        <i class="bi bi-save"></i>

                        <span id="saveWeeklyScheduleText">
                            Save Weekly Schedule
                        </span>

                    </button>

                </form>


            </div>

        </div>

    </div>


</div>


<script>

function beginButtonAction(
    buttonId,
    textId,
    progressText
)
{
    const button =
        document.getElementById(
            buttonId
        );


    const text =
        document.getElementById(
            textId
        );


    if (!button || !text) {
        return;
    }


    button.disabled = true;


    text.textContent =
        progressText;


    button.insertAdjacentHTML(
        'afterbegin',
        '<span class="spinner-border spinner-border-sm me-2"></span>'
    );
}


function sendDailyReport()
{
    beginButtonAction(
        'sendDailyReportButton',
        'sendDailyReportText',
        'Sending Daily Report...'
    );
}


function sendWeeklyReport()
{
    beginButtonAction(
        'sendWeeklyReportButton',
        'sendWeeklyReportText',
        'Sending Weekly Report...'
    );
}


function saveDailySchedule()
{
    beginButtonAction(
        'saveDailyScheduleButton',
        'saveDailyScheduleText',
        'Saving Daily Schedule...'
    );
}


function saveWeeklySchedule()
{
    beginButtonAction(
        'saveWeeklyScheduleButton',
        'saveWeeklyScheduleText',
        'Saving Weekly Schedule...'
    );
}

</script>


{% endblock %}
