{% extends "layouts/base.twig" %}

{% block content %}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

    <div>

        <h1 class="mb-1">
            Weekly Payroll Summary
        </h1>

        <div class="text-muted">

            {{ summary.week_start }}
            through
            {{ summary.week_end }}

            <span class="ms-2">
                {{ summary.timezone }}
            </span>

        </div>

    </div>


    <div class="d-flex flex-wrap gap-2">

        <a
            href="/reports/payroll"
            class="btn btn-outline-secondary"
        >

            <i class="bi bi-calendar-day"></i>

            Daily Payroll

        </a>


        <a
            href="/reports/payroll/weekly/export/csv"
            class="btn btn-success"
        >

            <i class="bi bi-file-earmark-spreadsheet"></i>

            Download CSV

        </a>


        <a
            href="/reports/payroll/weekly/export/pdf"
            class="btn btn-danger"
        >

            <i class="bi bi-file-earmark-pdf"></i>

            Download PDF

        </a>

    </div>

</div>


<div class="card shadow-sm">

    <div class="card-body">


        <div class="table-responsive">

            <table class="table table-striped align-middle">

                <thead>

                    <tr>

                        <th>
                            Employee
                        </th>

                        <th>
                            Employee #
                        </th>

                        <th>
                            Department
                        </th>

                        <th>
                            Gross
                        </th>

                        <th>
                            Regular
                        </th>

                        <th>
                            Daily OT
                        </th>

                        <th>
                            Weekly OT
                        </th>

                        <th>
                            Double Time
                        </th>

                        <th>
                            Total OT
                        </th>

                        <th>
                            Premium
                        </th>

                        <th>
                            Payable
                        </th>

                        <th>
                            Status
                        </th>

                    </tr>

                </thead>


                <tbody>


                    {% for employee in summary.employees %}

                        {% set dailyOvertime =
                            employee.daily_overtime_hours
                            |default(0)
                        %}


                        {% set weeklyOvertime =
                            employee.weekly_overtime_hours
                            |default(0)
                        %}


                        {% set doubleTime =
                            employee.double_time_hours
                            |default(0)
                        %}


                        {% set totalOvertime =
                            employee.overtime_hours
                            |default(
                                dailyOvertime
                                +
                                weeklyOvertime
                            )
                        %}


                        {% set premiumHours =
                            employee.premium_hours
                            |default(
                                totalOvertime
                                +
                                doubleTime
                            )
                        %}


                        <tr>

                            <td>
                                {{ employee.name }}
                            </td>


                            <td>
                                {{ employee.employee_number }}
                            </td>


                            <td>
                                {{ employee.department ?: '—' }}
                            </td>


                            <td>
                                {{ employee.gross_hours|number_format(2) }}
                            </td>


                            <td>
                                {{ employee.regular_hours|number_format(2) }}
                            </td>


                            <td>
                                {{ dailyOvertime|number_format(2) }}
                            </td>


                            <td>
                                {{ weeklyOvertime|number_format(2) }}
                            </td>


                            <td>
                                {{ doubleTime|number_format(2) }}
                            </td>


                            <td>
                                {{ totalOvertime|number_format(2) }}
                            </td>


                            <td>
                                {{ premiumHours|number_format(2) }}
                            </td>


                            <td>

                                <strong>
                                    {{ employee.total_hours|number_format(2) }}
                                </strong>

                            </td>


                            <td>

                                {% if employee.complete %}

                                    <span class="badge text-bg-success">
                                        Complete
                                    </span>

                                {% else %}

                                    <span class="badge text-bg-warning">
                                        Needs Review
                                    </span>

                                {% endif %}

                            </td>

                        </tr>


                        <tr>

                            <td colspan="12">

                                <div class="table-responsive">

                                    <table class="table table-sm mb-0">

                                        <thead>

                                            <tr>

                                                <th>
                                                    Date
                                                </th>

                                                <th>
                                                    Gross
                                                </th>

                                                <th>
                                                    Meal
                                                </th>

                                                <th>
                                                    Unpaid Break
                                                </th>

                                                <th>
                                                    Regular
                                                </th>

                                                <th>
                                                    Daily OT
                                                </th>

                                                <th>
                                                    Double Time
                                                </th>

                                                <th>
                                                    Premium
                                                </th>

                                                <th>
                                                    Payable
                                                </th>

                                                <th>
                                                    Status
                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody>

                                            {% for day in employee.days %}

                                                {% set dayDailyOvertime =
                                                    day.daily_overtime_hours
                                                    |default(
                                                        day.overtime_hours
                                                        |default(0)
                                                    )
                                                %}


                                                {% set dayDoubleTime =
                                                    day.double_time_hours
                                                    |default(0)
                                                %}


                                                {% set dayPremium =
                                                    day.premium_hours
                                                    |default(
                                                        dayDailyOvertime
                                                        +
                                                        dayDoubleTime
                                                    )
                                                %}


                                                <tr>

                                                    <td>
                                                        {{ day.date }}
                                                    </td>


                                                    <td>
                                                        {{ day.gross_hours|number_format(2) }}
                                                    </td>


                                                    <td>

                                                        {% set mealMinutes =
                                                            day.recorded_meal_minutes
                                                            +
                                                            day.automatic_meal_deduction_minutes
                                                        %}

                                                        {{ mealMinutes }} min

                                                    </td>


                                                    <td>
                                                        {{ day.unpaid_break_minutes }} min
                                                    </td>


                                                    <td>
                                                        {{ day.regular_hours|number_format(2) }}
                                                    </td>


                                                    <td>
                                                        {{ dayDailyOvertime|number_format(2) }}
                                                    </td>


                                                    <td>
                                                        {{ dayDoubleTime|number_format(2) }}
                                                    </td>


                                                    <td>
                                                        {{ dayPremium|number_format(2) }}
                                                    </td>


                                                    <td>
                                                        {{ day.total_hours|number_format(2) }}
                                                    </td>


                                                    <td>

                                                        {% if day.complete %}

                                                            <span class="badge text-bg-success">
                                                                Complete
                                                            </span>

                                                        {% else %}

                                                            <span class="badge text-bg-warning">
                                                                Needs Review
                                                            </span>

                                                        {% endif %}

                                                    </td>

                                                </tr>


                                                {% if not day.complete %}

                                                    <tr class="table-warning">

                                                        <td colspan="10">

                                                            <ul class="mb-0">

                                                                {% for error in day.errors %}

                                                                    <li>
                                                                        {{ error }}
                                                                    </li>

                                                                {% endfor %}

                                                            </ul>

                                                        </td>

                                                    </tr>

                                                {% endif %}

                                            {% endfor %}

                                        </tbody>

                                    </table>

                                </div>

                            </td>

                        </tr>


                    {% else %}

                        <tr>

                            <td
                                colspan="12"
                                class="text-center text-muted"
                            >
                                No weekly payroll data available.
                            </td>

                        </tr>

                    {% endfor %}


                </tbody>

            </table>

        </div>


        <div class="small text-muted mt-3">

            Total overtime includes daily and weekly overtime.

            Premium hours include total overtime plus double-time hours.

        </div>


    </div>

</div>


{% endblock %}
