{% extends "layouts/base.twig" %}

{% block content %}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

    <div>

        <h1 class="mb-1">
            Weekly Payroll Summary
        </h1>

        <div class="text-muted">

            {{ summary.week_start }}
            through
            {{ summary.week_end }}

            <span class="ms-2">
                {{ summary.timezone }}
            </span>

        </div>

    </div>


    <a
        href="/reports/payroll"
        class="btn btn-outline-secondary"
    >
        Daily Payroll
    </a>

</div>


<div class="card shadow-sm">

    <div class="card-body">


        <div class="table-responsive">

            <table class="table table-striped align-middle">

                <thead>

                    <tr>

                        <th>
                            Employee
                        </th>

                        <th>
                            Employee #
                        </th>

                        <th>
                            Department
                        </th>

                        <th>
                            Gross
                        </th>

                        <th>
                            Regular
                        </th>

                        <th>
                            Daily OT
                        </th>

                        <th>
                            Weekly OT
                        </th>

                        <th>
                            Total OT
                        </th>

                        <th>
                            Payable
                        </th>

                        <th>
                            Status
                        </th>

                    </tr>

                </thead>


                <tbody>


                    {% for employee in summary.employees %}

                        <tr>

                            <td>
                                {{ employee.name }}
                            </td>


                            <td>
                                {{ employee.employee_number }}
                            </td>


                            <td>
                                {{ employee.department ?: '—' }}
                            </td>


                            <td>
                                {{ employee.gross_hours|number_format(2) }}
                            </td>


                            <td>
                                {{ employee.regular_hours|number_format(2) }}
                            </td>


                            <td>
                                {{ employee.daily_overtime_hours|number_format(2) }}
                            </td>


                            <td>
                                {{ employee.weekly_overtime_hours|number_format(2) }}
                            </td>


                            <td>
                                {{ employee.overtime_hours|number_format(2) }}
                            </td>


                            <td>
                                <strong>
                                    {{ employee.total_hours|number_format(2) }}
                                </strong>
                            </td>


                            <td>

                                {% if employee.complete %}

                                    <span class="badge text-bg-success">
                                        Complete
                                    </span>

                                {% else %}

                                    <span class="badge text-bg-warning">
                                        Needs Review
                                    </span>

                                {% endif %}

                            </td>

                        </tr>


                        <tr>

                            <td colspan="10">

                                <div class="table-responsive">

                                    <table class="table table-sm mb-0">

                                        <thead>

                                            <tr>

                                                <th>
                                                    Date
                                                </th>

                                                <th>
                                                    Gross
                                                </th>

                                                <th>
                                                    Meal
                                                </th>

                                                <th>
                                                    Unpaid Break
                                                </th>

                                                <th>
                                                    Regular
                                                </th>

                                                <th>
                                                    Daily OT
                                                </th>

                                                <th>
                                                    Payable
                                                </th>

                                                <th>
                                                    Status
                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody>

                                            {% for day in employee.days %}

                                                <tr>

                                                    <td>
                                                        {{ day.date }}
                                                    </td>


                                                    <td>
                                                        {{ day.gross_hours|number_format(2) }}
                                                    </td>


                                                    <td>

                                                        {% set mealMinutes =
                                                            day.recorded_meal_minutes
                                                            +
                                                            day.automatic_meal_deduction_minutes
                                                        %}

                                                        {{ mealMinutes }} min

                                                    </td>


                                                    <td>
                                                        {{ day.unpaid_break_minutes }} min
                                                    </td>


                                                    <td>
                                                        {{ day.regular_hours|number_format(2) }}
                                                    </td>


                                                    <td>
                                                        {{ day.overtime_hours|number_format(2) }}
                                                    </td>


                                                    <td>
                                                        {{ day.total_hours|number_format(2) }}
                                                    </td>


                                                    <td>

                                                        {% if day.complete %}

                                                            <span class="badge text-bg-success">
                                                                Complete
                                                            </span>

                                                        {% else %}

                                                            <span class="badge text-bg-warning">
                                                                Needs Review
                                                            </span>

                                                        {% endif %}

                                                    </td>

                                                </tr>


                                                {% if not day.complete %}

                                                    <tr class="table-warning">

                                                        <td colspan="8">

                                                            <ul class="mb-0">

                                                                {% for error in day.errors %}

                                                                    <li>
                                                                        {{ error }}
                                                                    </li>

                                                                {% endfor %}

                                                            </ul>

                                                        </td>

                                                    </tr>

                                                {% endif %}

                                            {% endfor %}

                                        </tbody>

                                    </table>

                                </div>

                            </td>

                        </tr>


                    {% else %}

                        <tr>

                            <td
                                colspan="10"
                                class="text-center text-muted"
                            >
                                No weekly payroll data available.
                            </td>

                        </tr>

                    {% endfor %}


                </tbody>

            </table>

        </div>


    </div>

</div>


{% endblock %}
