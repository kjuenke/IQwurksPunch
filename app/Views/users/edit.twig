{% extends "layouts/base.twig" %}

{% block content %}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

    <div>

        <h1 class="mb-1">
            Edit User
        </h1>

        <div class="text-muted">
            Update account identity and authorized role.
        </div>

    </div>


    <a
        href="/admin/users"
        class="btn btn-outline-secondary"
    >

        <i class="bi bi-arrow-left me-1"></i>

        Back to Users

    </a>

</div>


{% if errors %}

    <div class="alert alert-danger">

        <strong>
            The account could not be updated.
        </strong>

        <ul class="mb-0 mt-2">

            {% for error in errors %}

                <li>
                    {{ error }}
                </li>

            {% endfor %}

        </ul>

    </div>

{% endif %}


<div class="row g-4">

    <div class="col-xl-8">

        <div class="card shadow-sm">

            <div class="card-header bg-body-tertiary">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                    <span class="fw-semibold">
                        Account Information
                    </span>


                    <div class="d-flex gap-2">

                        {% if user.active %}

                            <span class="badge text-bg-success">
                                Active
                            </span>

                        {% else %}

                            <span class="badge text-bg-secondary">
                                Inactive
                            </span>

                        {% endif %}


                        {% if user.is_self %}

                            <span class="badge text-bg-primary">
                                Current account
                            </span>

                        {% endif %}


                        {% if user.is_final_active_administrator %}

                            <span class="badge text-bg-warning">
                                Protected administrator
                            </span>

                        {% endif %}

                    </div>

                </div>

            </div>


            <div class="card-body">

                <form
                    method="post"
                    action="/admin/users/edit/{{ user.id }}"
                >

                    <div class="row g-3">

                        <div class="col-md-6">

                            <label
                                for="username"
                                class="form-label"
                            >
                                Username
                            </label>

                            <input
                                type="text"
                                id="username"
                                name="username"
                                class="form-control"
                                value="{{ form.username|default('') }}"
                                minlength="3"
                                maxlength="64"
                                pattern="[A-Za-z0-9._-]+"
                                required
                                autofocus
                            >

                            <div class="form-text">
                                Letters, numbers, periods, underscores, and
                                hyphens are allowed.
                            </div>

                        </div>


                        <div class="col-md-6">

                            <label
                                for="email"
                                class="form-label"
                            >
                                Email Address
                            </label>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                class="form-control"
                                value="{{ form.email|default('') }}"
                                maxlength="254"
                                required
                            >

                        </div>


                        <div class="col-md-6">

                            <label
                                for="role"
                                class="form-label"
                            >
                                Role
                            </label>

                            <select
                                id="role"
                                name="role"
                                class="form-select"
                                required
                            >

                                <option
                                    value="supervisor"
                                    {% if form.role|default('supervisor') == 'supervisor' %}
                                        selected
                                    {% endif %}
                                    {% if
                                        user.is_self
                                        and
                                        user.role == 'admin'
                                    %}
                                        disabled
                                    {% endif %}
                                    {% if user.is_final_active_administrator %}
                                        disabled
                                    {% endif %}
                                >
                                    Supervisor
                                </option>

                                <option
                                    value="admin"
                                    {% if form.role|default('supervisor') == 'admin' %}
                                        selected
                                    {% endif %}
                                >
                                    Administrator
                                </option>

                            </select>

                            {% if
                                user.is_self
                                and
                                user.role == 'admin'
                            %}

                                <div class="form-text text-warning">
                                    You cannot remove your own administrator role
                                    while signed in.
                                </div>

                            {% elseif user.is_final_active_administrator %}

                                <div class="form-text text-warning">
                                    The final active administrator cannot be
                                    changed to a supervisor.
                                </div>

                            {% endif %}

                        </div>


                        <div class="col-md-6">

                            <div class="border rounded p-3 h-100">

                                <div class="small text-muted">
                                    Created
                                </div>

                                <div>
                                    {{ user.created_at|default('—') }}
                                </div>


                                <div class="small text-muted mt-3">
                                    Last Login
                                </div>

                                <div>
                                    {{ user.last_login|default('Never') }}
                                </div>

                            </div>

                        </div>


                        <div class="col-12">

                            <hr>

                            <div class="d-flex flex-wrap gap-2">

                                <button
                                    type="submit"
                                    class="btn btn-primary"
                                >

                                    <i class="bi bi-save me-1"></i>

                                    Save Account

                                </button>


                                <a
                                    href="/admin/users/password/{{ user.id }}"
                                    class="btn btn-outline-secondary"
                                >

                                    <i class="bi bi-key me-1"></i>

                                    Reset Password

                                </a>


                                <a
                                    href="/admin/users"
                                    class="btn btn-outline-secondary"
                                >
                                    Cancel
                                </a>

                            </div>

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>


    <div class="col-xl-4">

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-body-tertiary">

                <span class="fw-semibold">
                    Account Status
                </span>

            </div>


            <div class="card-body">

                {% if user.can_activate %}

                    <p class="text-muted">
                        This account is inactive and cannot sign in.
                    </p>

                    <form
                        method="post"
                        action="/admin/users/activate"
                    >

                        <input
                            type="hidden"
                            name="id"
                            value="{{ user.id }}"
                        >

                        <button
                            type="submit"
                            class="btn btn-success w-100"
                        >

                            <i class="bi bi-person-check me-1"></i>

                            Activate Account

                        </button>

                    </form>

                {% elseif user.can_deactivate %}

                    <p class="text-muted">
                        Deactivation prevents future logins while preserving
                        account and audit history.
                    </p>

                    <form
                        method="post"
                        action="/admin/users/deactivate"
                        onsubmit="return confirm('Deactivate {{ user.username|e('js') }}?');"
                    >

                        <input
                            type="hidden"
                            name="id"
                            value="{{ user.id }}"
                        >

                        <button
                            type="submit"
                            class="btn btn-outline-danger w-100"
                        >

                            <i class="bi bi-person-dash me-1"></i>

                            Deactivate Account

                        </button>

                    </form>

                {% else %}

                    <div class="alert alert-warning mb-0">

                        <i class="bi bi-shield-lock me-1"></i>

                        {% if user.is_self %}

                            You cannot deactivate your own signed-in account.

                        {% else %}

                            The final active administrator is protected.

                        {% endif %}

                    </div>

                {% endif %}

            </div>

        </div>


        <div class="card shadow-sm">

            <div class="card-header bg-body-tertiary">

                <span class="fw-semibold">
                    Role Guidance
                </span>

            </div>


            <div class="card-body">

                <strong>
                    Supervisor
                </strong>

                <p class="small text-muted">
                    Operational access to employee, punch, report, exception,
                    and payroll-period workflows.
                </p>


                <strong>
                    Administrator
                </strong>

                <p class="small text-muted mb-0">
                    Includes protected settings and supervisor-account
                    management authority.
                </p>

            </div>

        </div>

    </div>

</div>

{% endblock %}
