{% extends "layouts/base.twig" %}

{% block content %}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

    <div>

        <h1 class="mb-1">
            Reset User Password
        </h1>

        <div class="text-muted">
            Set a new password without displaying or recovering the old one.
        </div>

    </div>


    <a
        href="/admin/users"
        class="btn btn-outline-secondary"
    >

        <i class="bi bi-arrow-left me-1"></i>

        Back to Users

    </a>

</div>


{% if errors %}

    <div class="alert alert-danger">

        <strong>
            The password could not be reset.
        </strong>

        <ul class="mb-0 mt-2">

            {% for error in errors %}

                <li>
                    {{ error }}
                </li>

            {% endfor %}

        </ul>

    </div>

{% endif %}


<div class="row justify-content-center">

    <div class="col-xl-7">

        <div class="card shadow-sm">

            <div class="card-header bg-body-tertiary">

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

                    <span class="fw-semibold">
                        {{ user.username }}
                    </span>

                    <div class="d-flex gap-2">

                        {% if user.role == 'admin' %}

                            <span class="badge text-bg-dark">
                                Administrator
                            </span>

                        {% else %}

                            <span class="badge text-bg-info">
                                Supervisor
                            </span>

                        {% endif %}


                        {% if user.active %}

                            <span class="badge text-bg-success">
                                Active
                            </span>

                        {% else %}

                            <span class="badge text-bg-secondary">
                                Inactive
                            </span>

                        {% endif %}

                    </div>

                </div>

            </div>


            <div class="card-body">

                <div class="alert alert-info">

                    <i class="bi bi-shield-lock me-1"></i>

                    Passwords are stored only as secure hashes. The existing
                    password cannot be viewed or recovered.

                </div>


                <form
                    method="post"
                    action="/admin/users/password/{{ user.id }}"
                >

                    <div class="mb-3">

                        <label
                            for="password"
                            class="form-label"
                        >
                            New Password
                        </label>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            class="form-control"
                            minlength="12"
                            autocomplete="new-password"
                            required
                            autofocus
                        >

                        <div class="form-text">
                            The password must contain at least 12 characters.
                        </div>

                    </div>


                    <div class="mb-4">

                        <label
                            for="confirm_password"
                            class="form-label"
                        >
                            Confirm New Password
                        </label>

                        <input
                            type="password"
                            id="confirm_password"
                            name="confirm_password"
                            class="form-control"
                            minlength="12"
                            autocomplete="new-password"
                            required
                        >

                    </div>


                    <div class="d-flex flex-wrap gap-2">

                        <button
                            type="submit"
                            class="btn btn-primary"
                        >

                            <i class="bi bi-key me-1"></i>

                            Reset Password

                        </button>


                        <a
                            href="/admin/users/edit/{{ user.id }}"
                            class="btn btn-outline-secondary"
                        >
                            Cancel
                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

{% endblock %}
