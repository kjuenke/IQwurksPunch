{% extends "layouts/base.twig" %}

{% block content %}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

    <div>

        <h1 class="mb-1">
            User-Management Activity
        </h1>

        <div class="text-muted">
            Review recent account-management actions and blocked attempts.
        </div>

    </div>


    <div class="d-flex flex-wrap gap-2">

        <a
            href="/admin/users"
            class="btn btn-outline-secondary"
        >

            <i class="bi bi-arrow-left me-1"></i>

            Back to Users

        </a>


        <a
            href="/admin/users/create"
            class="btn btn-primary"
        >

            <i class="bi bi-person-plus me-1"></i>

            Create User

        </a>

    </div>

</div>


<div class="alert alert-info">

    <div class="d-flex gap-3">

        <i class="bi bi-shield-check fs-4"></i>

        <div>

            <strong>
                Security-sensitive activity
            </strong>

            <div class="mt-1">

                This history records account-management activity without
                recording passwords or password hashes. Blocked actions are
                retained to help identify mistakes and unauthorized attempts.

            </div>

        </div>

    </div>

</div>


<div class="card shadow-sm">

    <div class="card-header bg-body-tertiary">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">

            <span class="fw-semibold">
                Recent User Actions
            </span>

            <span class="badge text-bg-secondary">
                Up to 100 events
            </span>

        </div>

    </div>


    <div class="card-body p-0">

        {% if actions %}

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead>

                        <tr>

                            <th scope="col">
                                Date and Time
                            </th>

                            <th scope="col">
                                Action
                            </th>

                            <th scope="col">
                                Acting User
                            </th>

                            <th scope="col">
                                Details
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        {% for action in actions %}

                            <tr>

                                <td class="text-nowrap">
                                    {{ action.created_at|default('—') }}
                                </td>


                                <td>

                                    {% if
                                        action.action ends with '_blocked'
                                    %}

                                        <span class="badge text-bg-warning">
                                            {{ action.action|replace({
                                                '.': ' ',
                                                '_': ' '
                                            })|title }}
                                        </span>

                                    {% elseif
                                        action.action == 'user.deactivated'
                                    %}

                                        <span class="badge text-bg-secondary">
                                            User Deactivated
                                        </span>

                                    {% elseif
                                        action.action == 'user.activated'
                                    %}

                                        <span class="badge text-bg-success">
                                            User Activated
                                        </span>

                                    {% elseif
                                        action.action == 'user.password_reset'
                                    %}

                                        <span class="badge text-bg-primary">
                                            Password Reset
                                        </span>

                                    {% else %}

                                        <span class="badge text-bg-info">
                                            {{ action.action|replace({
                                                '.': ' ',
                                                '_': ' '
                                            })|title }}
                                        </span>

                                    {% endif %}

                                </td>


                                <td>

                                    {% if action.actor_username %}

                                        <div class="fw-semibold">
                                            {{ action.actor_username }}
                                        </div>

                                        <div class="small text-muted">
                                            User ID {{ action.user_id }}
                                        </div>

                                    {% elseif action.user_id %}

                                        <div class="text-muted">
                                            Former user ID {{ action.user_id }}
                                        </div>

                                    {% else %}

                                        <div class="text-muted">
                                            System or unknown actor
                                        </div>

                                    {% endif %}

                                </td>


                                <td>
                                    {{ action.details|default('—') }}
                                </td>

                            </tr>

                        {% endfor %}

                    </tbody>

                </table>

            </div>

        {% else %}

            <div class="p-5 text-center">

                <div class="display-6 text-muted mb-3">

                    <i class="bi bi-clock-history"></i>

                </div>

                <h2 class="h5">
                    No user-management activity
                </h2>

                <p class="text-muted mb-0">
                    Account-management actions will appear here after they
                    occur.
                </p>

            </div>

        {% endif %}

    </div>

</div>

{% endblock %}
