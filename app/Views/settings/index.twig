{% extends "layouts/base.twig" %}

{% block content %}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">

    <div>

        <h1 class="mb-1">
            Company Settings
        </h1>

        <div class="text-muted">
            Configure company information and timekeeping behavior.
        </div>

    </div>


    <a
        href="/admin/labor-rules"
        class="btn btn-outline-primary"
    >
        <i class="bi bi-calculator"></i>
        Labor Rules
    </a>

</div>


<div class="alert alert-info d-flex align-items-start gap-3">

    <i class="bi bi-info-circle fs-4"></i>

    <div>

        <strong>
            Overtime and workweek settings have moved.
        </strong>

        <div>
            Daily overtime, weekly overtime, double-time, and the workweek
            start day are now managed under
            <a
                href="/admin/labor-rules"
                class="alert-link"
            >
                Labor Rules
            </a>.
        </div>

    </div>

</div>


<div class="card shadow-sm">

    <div class="card-body">


        <form
            method="post"
            action="/admin/settings"
        >


            {#
                These hidden fields preserve compatibility with the existing
                CompanySettingsService. Labor Rules is authoritative for all
                overtime thresholds and the workweek start day.
            #}

            <input
                type="hidden"
                name="pay_period_start"
                value="{{ settings.pay_period_start|default('monday') }}"
            >

            <input
                type="hidden"
                name="daily_overtime_hours"
                value="{{ settings.daily_overtime_hours|default(8) }}"
            >

            <input
                type="hidden"
                name="weekly_overtime_hours"
                value="{{ settings.weekly_overtime_hours|default(40) }}"
            >


            <h2 class="h4 mb-3">
                Company Information
            </h2>


            <div class="mb-3">

                <label
                    class="form-label"
                    for="company_name"
                >
                    Company Name
                </label>

                <input
                    type="text"
                    id="company_name"
                    name="company_name"
                    class="form-control"
                    value="{{ settings.company_name }}"
                >

            </div>


            <div class="mb-3">

                <label
                    class="form-label"
                    for="address"
                >
                    Address
                </label>

                <input
                    type="text"
                    id="address"
                    name="address"
                    class="form-control"
                    value="{{ settings.address }}"
                >

            </div>


            <div class="row">


                <div class="col-md-5 mb-3">

                    <label
                        class="form-label"
                        for="city"
                    >
                        City
                    </label>

                    <input
                        type="text"
                        id="city"
                        name="city"
                        class="form-control"
                        value="{{ settings.city }}"
                    >

                </div>


                <div class="col-md-3 mb-3">

                    <label
                        class="form-label"
                        for="state"
                    >
                        State
                    </label>

                    <input
                        type="text"
                        id="state"
                        name="state"
                        class="form-control"
                        value="{{ settings.state }}"
                    >

                </div>


                <div class="col-md-4 mb-3">

                    <label
                        class="form-label"
                        for="zip"
                    >
                        ZIP
                    </label>

                    <input
                        type="text"
                        id="zip"
                        name="zip"
                        class="form-control"
                        value="{{ settings.zip }}"
                    >

                </div>


            </div>


            <div class="row">


                <div class="col-md-6 mb-3">

                    <label
                        class="form-label"
                        for="phone"
                    >
                        Phone
                    </label>

                    <input
                        type="text"
                        id="phone"
                        name="phone"
                        class="form-control"
                        value="{{ settings.phone }}"
                    >

                </div>


                <div class="col-md-6 mb-3">

                    <label
                        class="form-label"
                        for="email"
                    >
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-control"
                        value="{{ settings.email }}"
                    >

                </div>


            </div>


            <div class="mb-3">

                <label
                    class="form-label"
                    for="timezone"
                >
                    Timezone
                </label>


                <select
                    id="timezone"
                    name="timezone"
                    class="form-select"
                >


                    <option
                        value="America/Los_Angeles"
                        {% if settings.timezone == 'America/Los_Angeles' %}
                        selected
                        {% endif %}
                    >
                        Pacific Time
                    </option>


                    <option
                        value="America/Denver"
                        {% if settings.timezone == 'America/Denver' %}
                        selected
                        {% endif %}
                    >
                        Mountain Time
                    </option>


                    <option
                        value="America/Chicago"
                        {% if settings.timezone == 'America/Chicago' %}
                        selected
                        {% endif %}
                    >
                        Central Time
                    </option>


                    <option
                        value="America/New_York"
                        {% if settings.timezone == 'America/New_York' %}
                        selected
                        {% endif %}
                    >
                        Eastern Time
                    </option>


                </select>

            </div>


            <hr class="my-4">


            <h2 class="h4 mb-1">
                Kiosk Safety
            </h2>

            <p class="text-muted mb-4">
                Automatically clear an unfinished employee interaction when
                the kiosk is left unattended.
            </p>


            <div class="row">


                <div class="col-md-6 mb-3">

                    <label
                        class="form-label"
                        for="kiosk_inactivity_timeout_seconds"
                    >
                        Kiosk Inactivity Timeout
                    </label>

                    {% set kioskTimeout =
                        settings.kiosk_inactivity_timeout_seconds|default(60)
                    %}

                    <div class="input-group">

                        <input
                            type="number"
                            id="kiosk_inactivity_timeout_seconds"
                            name="kiosk_inactivity_timeout_seconds"
                            class="form-control"
                            min="15"
                            max="600"
                            step="1"
                            required
                            value="{{ kioskTimeout }}"
                        >

                        <span class="input-group-text">
                            seconds
                        </span>

                    </div>

                    <div class="form-text">
                        Allowed range: 15–600 seconds. The default is
                        60 seconds. Keyboard, mouse, and touch activity will
                        restart the countdown.
                    </div>

                </div>


                <div class="col-md-6 mb-3">

                    <div class="alert alert-secondary h-100 mb-0">

                        <div class="d-flex gap-3">

                            <i class="bi bi-shield-check fs-4"></i>

                            <div>

                                <strong>
                                    What happens at timeout?
                                </strong>

                                <div class="mt-1">
                                    The employee number, PIN, selected employee,
                                    and temporary authentication state are
                                    cleared. No punch is submitted
                                    automatically.
                                </div>

                            </div>

                        </div>

                    </div>

                </div>


            </div>


            <hr class="my-4">


            <h2 class="h4 mb-1">
                Timekeeping Policy
            </h2>

            <p class="text-muted mb-4">
                Configure punch rounding, automatic meal deductions, and
                paid-break allowances.
            </p>


            <div class="row">


                <div class="col-md-6 mb-3">

                    <label
                        class="form-label"
                        for="rounding_minutes"
                    >
                        Punch Rounding Interval
                    </label>

                    {% set roundingMinutes =
                        settings.rounding_minutes|default(15)
                    %}

                    <select
                        id="rounding_minutes"
                        name="rounding_minutes"
                        class="form-select"
                    >

                        <option
                            value="0"
                            {% if roundingMinutes == 0 %}
                            selected
                            {% endif %}
                        >
                            No rounding
                        </option>

                        <option
                            value="5"
                            {% if roundingMinutes == 5 %}
                            selected
                            {% endif %}
                        >
                            5 minutes
                        </option>

                        <option
                            value="6"
                            {% if roundingMinutes == 6 %}
                            selected
                            {% endif %}
                        >
                            6 minutes
                        </option>

                        <option
                            value="10"
                            {% if roundingMinutes == 10 %}
                            selected
                            {% endif %}
                        >
                            10 minutes
                        </option>

                        <option
                            value="15"
                            {% if roundingMinutes == 15 %}
                            selected
                            {% endif %}
                        >
                            15 minutes
                        </option>

                        <option
                            value="30"
                            {% if roundingMinutes == 30 %}
                            selected
                            {% endif %}
                        >
                            30 minutes
                        </option>

                    </select>

                    <div class="form-text">
                        Punch times are adjusted to the selected interval
                        before payroll is calculated.
                    </div>

                </div>


                <div class="col-md-6 mb-3">

                    <label
                        class="form-label"
                        for="rounding_mode"
                    >
                        Punch Rounding Direction
                    </label>

                    {% set roundingMode =
                        settings.rounding_mode|default('nearest')
                    %}

                    <select
                        id="rounding_mode"
                        name="rounding_mode"
                        class="form-select"
                    >

                        <option
                            value="nearest"
                            {% if roundingMode == 'nearest' %}
                            selected
                            {% endif %}
                        >
                            Nearest interval
                        </option>

                        <option
                            value="up"
                            {% if roundingMode == 'up' %}
                            selected
                            {% endif %}
                        >
                            Always round up
                        </option>

                        <option
                            value="down"
                            {% if roundingMode == 'down' %}
                            selected
                            {% endif %}
                        >
                            Always round down
                        </option>

                    </select>

                    <div class="form-text">
                        Determines how punch times are moved when rounding is
                        enabled.
                    </div>

                </div>


            </div>


            <hr class="my-4">


            <h2 class="h4 mb-1">
                Meals and Breaks
            </h2>

            <p class="text-muted mb-4">
                Configure automatic unpaid meal deductions and the daily
                paid-break allowance.
            </p>


            <div class="form-check form-switch mb-4">

                <input
                    class="form-check-input"
                    type="checkbox"
                    id="meal_deduction_enabled"
                    name="meal_deduction_enabled"
                    {% if settings.meal_deduction_enabled|default(1) %}
                    checked
                    {% endif %}
                >

                <label
                    class="form-check-label"
                    for="meal_deduction_enabled"
                >
                    Enable automatic meal deduction
                </label>

                <div class="form-text">
                    Applies the configured meal deduction when no recorded
                    meal period satisfies the payroll policy.
                </div>

            </div>


            <div class="row">


                <div class="col-md-6 mb-3">

                    <label
                        class="form-label"
                        for="meal_deduction_minutes"
                    >
                        Automatic Meal Deduction
                    </label>

                    <div class="input-group">

                        <input
                            type="number"
                            id="meal_deduction_minutes"
                            name="meal_deduction_minutes"
                            class="form-control"
                            min="0"
                            max="240"
                            step="1"
                            value="{{ settings.meal_deduction_minutes|default(30) }}"
                        >

                        <span class="input-group-text">
                            minutes
                        </span>

                    </div>

                </div>


                <div class="col-md-6 mb-3">

                    <label
                        class="form-label"
                        for="paid_break_minutes"
                    >
                        Paid Break Allowance
                    </label>

                    <div class="input-group">

                        <input
                            type="number"
                            id="paid_break_minutes"
                            name="paid_break_minutes"
                            class="form-control"
                            min="0"
                            max="240"
                            step="1"
                            value="{{ settings.paid_break_minutes|default(20) }}"
                        >

                        <span class="input-group-text">
                            minutes per day
                        </span>

                    </div>

                </div>


            </div>


            <div class="d-flex flex-wrap gap-2 mt-3">

                <button
                    type="submit"
                    class="btn btn-primary"
                >
                    <i class="bi bi-save"></i>
                    Save Company Settings
                </button>


                <a
                    href="/admin/labor-rules"
                    class="btn btn-outline-secondary"
                >
                    <i class="bi bi-calculator"></i>
                    Manage Labor Rules
                </a>

            </div>


        </form>


    </div>

</div>


{% endblock %}
