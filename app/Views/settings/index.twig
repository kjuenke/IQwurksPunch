{% extends "layouts/base.twig" %}

{% block content %}

<h1 class="mb-4">
    Company Settings
</h1>


<div class="card shadow-sm">

<div class="card-body">


<form method="post"
      action="/admin/settings">


<div class="mb-3">

<label class="form-label">
Company Name
</label>

<input
type="text"
name="company_name"
class="form-control"
value="{{ settings.company_name }}"
>

</div>



<div class="mb-3">

<label class="form-label">
Address
</label>

<input
type="text"
name="address"
class="form-control"
value="{{ settings.address }}"
>

</div>



<div class="row">


<div class="col-md-5 mb-3">

<label class="form-label">
City
</label>

<input
type="text"
name="city"
class="form-control"
value="{{ settings.city }}"
>

</div>



<div class="col-md-3 mb-3">

<label class="form-label">
State
</label>

<input
type="text"
name="state"
class="form-control"
value="{{ settings.state }}"
>

</div>



<div class="col-md-4 mb-3">

<label class="form-label">
ZIP
</label>

<input
type="text"
name="zip"
class="form-control"
value="{{ settings.zip }}"
>

</div>


</div>



<div class="row">


<div class="col-md-6 mb-3">

<label class="form-label">
Phone
</label>

<input
type="text"
name="phone"
class="form-control"
value="{{ settings.phone }}"
>

</div>



<div class="col-md-6 mb-3">

<label class="form-label">
Email
</label>

<input
type="email"
name="email"
class="form-control"
value="{{ settings.email }}"
>

</div>


</div>




<div class="mb-3">

<label class="form-label">
Timezone
</label>


<select
name="timezone"
class="form-select"
>


<option value="America/Los_Angeles"
{% if settings.timezone == 'America/Los_Angeles' %}
selected
{% endif %}
>
Pacific Time
</option>


<option value="America/Denver"
{% if settings.timezone == 'America/Denver' %}
selected
{% endif %}
>
Mountain Time
</option>


<option value="America/Chicago"
{% if settings.timezone == 'America/Chicago' %}
selected
{% endif %}
>
Central Time
</option>


<option value="America/New_York"
{% if settings.timezone == 'America/New_York' %}
selected
{% endif %}
>
Eastern Time
</option>


</select>

</div>




<div class="mb-3">

<label class="form-label">
Pay Period Start
</label>


<select
name="pay_period_start"
class="form-select"
>


<option value="monday"
{% if settings.pay_period_start == 'monday' %}
selected
{% endif %}
>
Monday
</option>


<option value="sunday"
{% if settings.pay_period_start == 'sunday' %}
selected
{% endif %}
>
Sunday
</option>


</select>

</div>



<button class="btn btn-primary">

<i class="bi bi-save"></i>

Save Settings

</button>


</form>


</div>

</div>


{% endblock %}
