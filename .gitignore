# Composer dependencies
/vendor/

# Environment and secrets
.env
.env.*
config/mail.php

# Runtime databases
/database/sqlite/*.sqlite
/database/sqlite/*.sqlite-shm
/database/sqlite/*.sqlite-wal
/database/sqlite/*.sqlite-journal

# Logs
/storage/logs/*
!/storage/logs/.gitkeep

# Backups
/storage/backups/*
!/storage/backups/.gitkeep

# Generated exports and distribution packages
/storage/exports/*
!/storage/exports/.gitkeep

# Sessions
/storage/sessions/*
!/storage/sessions/.gitkeep

# Cache and temporary files
/storage/cache/*
!/storage/cache/.gitkeep
/.phpunit.cache/
/tmp/
*.tmp

# Development server output
*.log

# IDE files
.idea/
.vscode/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db

# Local backup and safety-copy files
*.backup
*.backup-*
*.before-*
*.bak
*~

# Legacy storage-root database protection
/storage/*.sqlite
/storage/*.sqlite-shm
/storage/*.sqlite-wal
/storage/*.sqlite-journal
/storage/*.db
